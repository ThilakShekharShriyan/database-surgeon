# Copy to .env and fill locally. Never paste keys into chat.
OPENAI_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
# Choose an exact closed model accessible to your account; no silent fallback.
OPENAI_MODEL=
GROQ_MODEL=openai/gpt-oss-120b
# Fireworks + NVIDIA Nemotron (prize eligibility). Paste a live serverless key.
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-20b
FIREWORKS_FAST_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
FIREWORKS_DEEP_MODEL=accounts/fireworks/models/gpt-oss-20b
FIREWORKS_ULTRA_MODEL=accounts/fireworks/models/nemotron-3-ultra-nvfp4
FIREWORKS_OSS20_MODEL=accounts/fireworks/models/gpt-oss-20b
# Price inputs are USD / million tokens. Unknown prices stay null in reports.
OPENAI_INPUT_PRICE=
OPENAI_CACHED_PRICE=
OPENAI_OUTPUT_PRICE=
GROQ_INPUT_PRICE=0.15
GROQ_CACHED_PRICE=
GROQ_OUTPUT_PRICE=0.60
FIREWORKS_INPUT_PRICE=0.15
FIREWORKS_CACHED_PRICE=0.03
FIREWORKS_OUTPUT_PRICE=0.50
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=surgeon
PGUSER=surgeon_reader
PGPASSWORD=local-benchmark-only


# Optional distinct Groq credential slots; shared accounts may share quotas.
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
